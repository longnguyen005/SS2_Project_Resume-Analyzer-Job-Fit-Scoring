POSTGRES_DB=resume_analyzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/resume_analyzer
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@db:5432/resume_analyzer
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
JWT_SECRET_KEY=change-me-in-production
SESSION_SECRET_KEY=change-me-session-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
OCR_FALLBACK_ENABLED=true
OCR_LANGUAGES=eng+vie
OCR_LANGUAGE_FALLBACK=eng
OCR_RENDER_SCALE=2.0
CORS_ORIGINS=http://localhost:5173
AI_MODE=live
AI_PROVIDER_LABEL=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=replace-with-your-provider-api-key
AI_MODEL=gemini-2.5-flash
AI_FALLBACK_PROVIDER_LABEL=gemini-fallback
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=gemini-2.5-flash-lite
AI_REQUEST_TIMEOUT_SECONDS=45
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
R2_ENABLED=false
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=resume-analyzer-files
R2_BUCKET_REGION=auto
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=uploads
N8N_WEBHOOK_URL=http://n8n:5678/webhook/analyze-cv
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_INTERNAL_SHARED_SECRET=change-me-internal-secret
N8N_WEBHOOK_TIMEOUT_SECONDS=60
N8N_WEBHOOK_MAX_ATTEMPTS=2
N8N_PROCESSING_CLAIM_TTL_SECONDS=900
# Import and activate n8n/workflows/cv-analysis-http-pipeline-staged.json after startup.
N8N_PUBLIC_URL=http://localhost:5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true

VITE_API_BASE_URL=http://localhost:8000/api/v1
