    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body ?? {};\nconst statusCode = Number(input.statusCode ?? 0);\nif (statusCode >= 200 && statusCode < 300) {\n  const claimStatus = body.claim_status;\n  if (claimStatus === 'claimed') {\n    return [{ json: { route: 'claimed', cv_upload_id: body.cv_upload_id } }];\n  }\n  if (claimStatus === 'already_completed') {\n    return [{ json: { route: 'already_completed', status: 'completed', cv_upload_id: body.cv_upload_id } }];\n  }\n  if (claimStatus === 'already_processing') {\n    return [{ json: { route: 'already_processing', status: 'processing', cv_upload_id: body.cv_upload_id } }];\n  }\n}\nconst failureReason = body.detail || body.message || body.failure_reason || body.raw || `HTTP ${statusCode || 'request failed'}`;\nreturn [{ json: { route: 'error', status: 'failed', failure_reason: failureReason, cv_upload_id: $('Normalize Payload').first().json.cv_upload_id } }];"
      },
